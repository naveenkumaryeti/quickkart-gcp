              "startup-script": "#!/bin/bash\n# Frontend VM bootstrap: nginx serves the static site and proxies /api to the internal load balancer of the backend tier.\nset -eu\nexport DEBIAN_FRONTEND=noninteractive\napt-get update -y \u0026\u0026 apt-get install -y nginx\ngcloud storage cp \"gs://quickart-gcp-quickkart-artifacts/frontend-5bb60404ab2f690e61edbe76c3366fde.tar.gz\" /tmp/frontend.tgz\nrm -rf /var/www/html/* \u0026\u0026 tar xzf /tmp/frontend.tgz -C /var/www/html\nrm -f /etc/nginx/sites-enabled/default\ncat \u003e /etc/nginx/conf.d/quickkart.conf \u003c\u003cNGINX\nserver {\n  listen 80 default_server;\n  root /var/www/html;\n  index index.html;\n  client_max_body_size 6m;\n  location /api/ { proxy_pass http://10.20.2.10:5000; proxy_read_timeout 60s; }\n}\nNGINX\nsystemctl restart nginx\n"
