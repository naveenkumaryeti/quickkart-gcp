project_id           = "your-gcp-project-id"   # or: export TF_VAR_project_id=$(gcloud config get-value project)
region               = "asia-south1"
zone                 = "asia-south1-a"
# bucket_name        = "my-unique-bucket"       # default: <project_id>-quickkart-storage
# domain             = "shop.example.com"       # enables HTTPS (Google-managed certificate)
# alert_email        = "you@example.com"
# retention_days     = 0
force_destroy_bucket = true                      # classroom default; set false for real data
